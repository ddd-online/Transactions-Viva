# Build output: `viva build`, `go build`, and packaged artifacts. The release
# scripts and notes are source and stay tracked.
/build/*
!/build/*.ps1
!/build/release_notes.md
!/build/release_template.md
*.exe
/transactions
*.test
coverage.out

# A workspace that happens to sit inside the repository: its SQLite database,
# WAL files and the backup a migration writes.
/transactions.db
/transactions.db-*
/transactions.db.bak

# Local design tooling: the skill's local config and its render mocks.
/.impeccable/config.local.json
/.impeccable/mocks/

# A local code index cache, not project source.
/.codegraph/

# Editor and OS clutter.
/.vscode/
.DS_Store
Thumbs.db
desktop.ini
